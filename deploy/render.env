# =====================================================================
#  VJ Filter Bot - environment variables for Render
# =====================================================================
#  HOW TO USE
#    Render dashboard -> your service -> Environment -> "Add from .env"
#    -> paste this whole file -> replace every CHANGE_ME -> Save.
#
#  READ THESE 3 WARNINGS FIRST
#  1. BOOLEAN FLAGS: core/info.py reads them as bool(environ.get(...)).
#     ANY non-empty value - including "False", "false" or "0" - turns the
#     feature ON. To keep a default-OFF flag off, do NOT define it at all.
#  2. Do NOT set PORT. Render sets it automatically and the bot reads it.
#  3. URL must END WITH A SLASH. The bot builds stream links as
#     f"{URL}watch/..." so a missing "/" breaks every stream/download link.
#
#  Lines starting with # are ignored. No inline comments after values.
# =====================================================================


# ---------------------------------------------------------------------
#  1. PYTHON VERSION  (required - Render's default is now Python 3.14,
#     which this repo's pinned packages cannot install on)
# ---------------------------------------------------------------------
PYTHON_VERSION=3.10.8


# ---------------------------------------------------------------------
#  2. REQUIRED
# ---------------------------------------------------------------------
# From @BotFather
BOT_TOKEN=CHANGE_ME
# From https://my.telegram.org/apps  (API_ID must be a number)
API_ID=CHANGE_ME
API_HASH=CHANGE_ME
# Admin user IDs, separated by a single space, e.g. "123456789 987654321"
ADMINS="CHANGE_ME"
# File/index channel IDs, space separated, e.g. "-1001234567890 -1009876543210"
CHANNELS="CHANGE_ME"
# Log channel ID (must be a number, bot must be admin there), e.g. -1001234567890
LOG_CHANNEL=CHANGE_ME
# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/...)
DATABASE_URI=CHANGE_ME
# Your Render URL WITH trailing slash. Deploy once, copy the URL shown at the
# top of the service page, put it here, then Save (triggers a redeploy).
URL=https://CHANGE-ME.onrender.com/


# ---------------------------------------------------------------------
#  3. OPTIONAL - IDs and text values (uncomment what you need)
# ---------------------------------------------------------------------
# Force-subscribe channel ID
# AUTH_CHANNEL=-1001234567890
# Channel that receives /request and #request messages
# REQST_CHANNEL=-1001234567890
# Channel for index requests (defaults to LOG_CHANNEL)
# INDEX_REQ_CHANNEL=-1001234567890
# Support group ID (bot will not send files there)
# SUPPORT_CHAT_ID=-1001234567890
# /batch file-store channels, space separated
# FILE_STORE_CHANNEL="-1001234567890"
# Channels used to delete files from the database, space separated
# DELETE_CHANNELS="-1001234567890"
# Extra users allowed to use the bot, space separated
# AUTH_USERS="123456789"
# Start-message pictures, space separated URLs
# PICS="https://example.com/pic1.jpg https://example.com/pic2.jpg"

# Database naming
# DATABASE_NAME=techvjclonefilterbot
# COLLECTION_NAME=vjcollection

# Links shown in the bot
# GRP_LNK=https://t.me/your_group
# CHNL_LNK=https://t.me/your_channel
# SUPPORT_CHAT=your_group_username
# OWNER_LNK=https://t.me/your_username

# Shortener (only used when SHORTLINK_MODE is turned on below)
# SHORTLINK_URL=
# SHORTLINK_API=
# TUTORIAL=

# Token verification (only used when VERIFY is turned on below)
# VERIFY_SHORTLINK_URL=
# VERIFY_SHORTLINK_API=
# VERIFY_TUTORIAL=
# VERIFY_SND_SHORTLINK_URL=
# VERIFY_SND_SHORTLINK_API=

# Premium / referral (PREMIUM_AND_REFERAL_MODE is ON by default)
# REFERAL_COUNT=20
# REFERAL_PREMEIUM_TIME=1month
# PAYMENT_QR=https://example.com/qr.jpg
# PAYMENT_TEXT=<b>Your plans and your real UPI ID here</b>

# Multiple databases (only used when MULTIPLE_DATABASE is turned on below)
# O_DB_URI=
# F_DB_URI=
# S_DB_URI=

# Clone bots (only used when CLONE_MODE is turned on below)
# CLONE_DATABASE_URI=
# PUBLIC_FILE_CHANNEL=your_public_channel_username


# ---------------------------------------------------------------------
#  4. OPTIONAL - FEATURES THAT ARE OFF BY DEFAULT
#     Uncomment a line to turn that feature ON. The value does not matter
#     (see warning 1), but keep it as True for clarity.
# ---------------------------------------------------------------------
# REQUEST_TO_JOIN_MODE=True
# TRY_AGAIN_BTN=True
# MULTIPLE_DATABASE=True
# CLONE_MODE=True
# IS_TUTORIAL=True
# IMDB=True
# LONG_IMDB_DESCRIPTION=True
# PROTECT_CONTENT=True
# NO_RESULTS_MSG=True
# VERIFY=True
# VERIFY_SECOND_SHORTNER=True
# SHORTLINK_MODE=True
# RENAME_MODE=True
# AUTO_APPROVE_MODE=True


# ---------------------------------------------------------------------
#  5. FEATURES THAT ARE ON BY DEFAULT (no need to set anything)
#     PREMIUM_AND_REFERAL_MODE, STREAM_MODE, AI_SPELL_CHECK, PM_SEARCH,
#     BUTTON_MODE, MAX_BTN, AUTO_FFILTER, AUTO_DELETE, SPELL_CHECK_REPLY,
#     MELCOW_NEW_USERS, PUBLIC_FILE_STORE, USE_CAPTION_FILTER
#     To switch one OFF, define it with an EMPTY value (e.g. IMDB=) - or
#     change its default in core/info.py if Render rejects empty values.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
#  6. OPTIONAL - built-in keep-alive self-ping
#     The bot only starts its self-ping when an env var named DYNO exists
#     (it was written for Heroku). Defining it enables the ping on Render.
#     PING_INTERVAL is in seconds; the default (1200) is LONGER than
#     Render's 15-minute free-tier idle timeout, so lower it.
#     An external UptimeRobot monitor is the more dependable option.
# ---------------------------------------------------------------------
# DYNO=1
# PING_INTERVAL=300
